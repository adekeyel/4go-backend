model Transactions {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  amount Int
  source String @default("purchase")
  description String?
  reference_id String? @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  @@index([user_id, source])
  @@index([user_id, created_at])

  @@map("transactions")
}

model Treasures {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  price Int
  icon String
  description String?
  sort_order Int @default(0)

  @@map("treasures")
}

model UserBlocks {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blocker_id String @db.Uuid
  blocked_id String @db.Uuid
  reason String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  @@unique([blocker_id, blocked_id])
  @@index([blocked_id])
  @@index([blocker_id])

  @@map("user_blocks")
}

model VerificationApplications {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  status String @default("pending")
  amount_ngn Decimal @default(10000) @db.Decimal(12,2)
  payment_ref String?
  applied_at DateTime @default(now()) @db.Timestamptz(6)
  reviewed_at DateTime? @db.Timestamptz(6)
  reviewed_by String? @db.Uuid
  review_notes String?
  is_verified Boolean @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  @@index([status])
  @@index([user_id])

  @@map("verification_applications")
}

model Withdrawals {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  amount Int
  naira_amount Decimal @db.Decimal(12,2)
  bank_code String
  account_number String
  account_name String
  status String @default("pending")
  flutterwave_ref String?
  processed_at DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("withdrawals")
}
